{
  "name": "playtimetcg",
  "version": "1.0.0",
  "private": true,
  "description": "Play Time — adult card game for couples: storefront, online play, admin. Next.js 16 + Prisma 7/PostgreSQL",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node --experimental-strip-types prisma/seed.mjs",
    "setup": "prisma generate && prisma db push && npm run db:seed",
    "typecheck": "tsc --noEmit",
    "cards:import": "node --experimental-strip-types scripts/import-card-art.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@napi-rs/canvas": "^1.0.9",
    "@prisma/client": "7.10.0",
    "dotenv": "^18.0.4",
    "next": "^16.3.6",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "7.10.0",
    "typescript": "^7.0.2"
  },
  "engines": { "node": ">=22.12" }
}
