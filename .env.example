# Play Time — environment template. Copy to `.env` and fill in.
# scripts/deploy.sh provisions PostgreSQL and writes DATABASE_URL on the server.

DATABASE_URL="postgresql://playtime:CHANGE_ME@localhost:5432/playtime"

# Optional: seed a known admin password (otherwise one is generated and printed once).
# SEED_ADMIN_EMAIL="you@playtimetcg.com"
# SEED_ADMIN_PASSWORD="change-me"

# Every other runtime secret (SendGrid, DivinityCoin keys, SEO ids…) is managed
# in /admin/settings and stored in the database. Values set here act as fallbacks.
# DIVINITYCOIN_API_URL="https://divinitycoin.com"
# DIVINITYCOIN_API_KEY=""
# DIVINITYCOIN_WEBHOOK_SECRET=""
# SENDGRID_API_KEY=""
